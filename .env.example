# Which EmailService backend to use: mailslurp (default, API-based) or
# guerrillamail (drives the real guerrillamail.com site in a headless
# browser, no signup/API key -- see src/email_service_guerrillamail.py for
# the caveats: ~1hr address lifetime, and its domains are heavily
# blocklisted already).
EMAIL_PROVIDER=mailslurp

# MailSlurp API Key https://app.mailslurp.com -- only needed if EMAIL_PROVIDER=mailslurp
MAILSLURP_API_KEY=your_mailslurp_api_key_here

# Android SDK location. Defaults to ~/Library/Android/sdk on macOS if unset.
ANDROID_HOME=/Users/you/Library/Android/sdk

# Appium server (run separately: `appium`)
APPIUM_SERVER_URL=http://127.0.0.1:4723

# AVD created by scripts/setup_emulator.sh -- reused + wiped between registrations
TACOBELL_AVD_NAME=tacobell_base

# Only needed if the AVD doesn't already have the app installed. Get this by
# extracting it from a real device: install the Taco Bell app there, then
#   adb shell pm path com.tacobell.ordering
#   adb pull <path from above> tacobell.apk
TACOBELL_APK_PATH=/absolute/path/to/tacobell.apk
TACOBELL_APP_PACKAGE=com.tacobell.ordering
# Leave unset -- Appium auto-detects the launch activity from the APK.
# Only set this if auto-detect picks the wrong screen for your APK version.
# TACOBELL_APP_ACTIVITY=.ui.launch.LaunchActivity
