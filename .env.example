# Which EmailService backend to use: mailslurp (default, API-based),
# guerrillamail (headless browser, no API key, heavily blocklisted domains,
# verified working end to end), or smailpro (headless browser, no API key,
# Gmail/Outlook domains that would bypass disposable-email blocklists --
# but currently BROKEN: its "Create" flow sits behind a live Cloudflare
# Turnstile challenge this provider doesn't solve, so it silently returns a
# constant placeholder address instead of a real mailbox. See
# src/email_service_smailpro.py and the README's "Email provider" section.
EMAIL_PROVIDER=mailslurp

# MailSlurp API Key https://app.mailslurp.com -- only needed if EMAIL_PROVIDER=mailslurp
MAILSLURP_API_KEY=your_mailslurp_api_key_here

# Android SDK location. Defaults to ~/Library/Android/sdk on macOS if unset.
ANDROID_HOME=/Users/you/Library/Android/sdk

# Appium server (run separately: `appium`)
APPIUM_SERVER_URL=http://127.0.0.1:4723

# AVD created by scripts/setup_emulator.sh -- reused + wiped between registrations
TACOBELL_AVD_NAME=tacobell_base

# Directory containing the split APKs to install (base.apk + one arch split +
# one density split + one language split) -- see README.md "Get the APK".
# Required every run: the AVD is wiped on every boot, so nothing persists.
TACOBELL_APK_DIR=/absolute/path/to/tacobell_apk

TACOBELL_APP_PACKAGE=com.tacobell.ordering
# Verified against a real APK (v8.90.2) -- shouldn't need to change unless a
# future app version renames its launch activity.
TACOBELL_APP_ACTIVITY=com.tacobell.splash.SplashActivity

# --- Akamai BMP evasion (see src/akamai_evasion.py) ---
# All optional with sensible defaults. Override only to tune against real
# device traces or adjust the sensor stream rate.
# Sensor stream update interval in seconds (default 0.2 = 5Hz)
# AKAMAI_SENSOR_INTERVAL=0.2
# Hand tremor noise sigma for accelerometer (m/s²) and gyroscope (rad/s)
# AKAMAI_TREMOR_ACCEL=0.15
# AKAMAI_TREMOR_GYRO=0.05
# Default phone holding orientation (radians from vertical)
# AKAMAI_DEFAULT_PITCH=0.35
# AKAMAI_DEFAULT_ROLL=0.05
